{
  "name": "folex-fx",
  "description": "Lightweight, LLM-friendly layering library that makes plain HTML look magical.",
  "keywords": ["css-effects", "glassmorphism", "particles", "canvas", "ripple", "glow", "llm-friendly", "zero-dependency", "visual-effects"],
  "author": "ElBenjaMasLindo",
  "license": "MPL-2.0",
  "version": "0.4.1",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.global.js",
      "default": "./dist/index.js"
    },
    "./folex.css": "./dist/folex.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && cp src/css/folex.css dist/folex.css",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "eslint . --fix",
    "lint": "eslint .",
    "gate": "eslint . && tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "eslint": "9.39.5",
    "happy-dom": "20.10.6",
    "husky": "9.1.7",
    "sadist": "0.5.3",
    "ts-pattern": "5.9.0",
    "tsup": "8.5.1",
    "typescript": "5.6.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.9.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElBenjaMasLindo/folex.git"
  },
  "homepage": "https://github.com/ElBenjaMasLindo/folex#readme",
  "bugs": {
    "url": "https://github.com/ElBenjaMasLindo/folex/issues"
  }
}
