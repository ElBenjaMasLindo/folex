{
  "name": "folex-fx",
  "version": "0.1.0",
  "description": "Lightweight, LLM-friendly layering library that makes plain HTML look magical.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.global.js",
      "default": "./dist/index.js"
    },
    "./folex.css": "./dist/folex.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && cp src/css/folex.css dist/folex.css",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "format": "biome format --write src tests"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "happy-dom": "20.10.6",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.9.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElBenjaMasLindo/folex.git"
  },
  "keywords": [
    "css-effects",
    "glassmorphism",
    "particles",
    "canvas",
    "ripple",
    "glow",
    "llm-friendly",
    "zero-dependency",
    "visual-effects"
  ],
  "author": "@elbenjamaslindo",
  "homepage": "https://github.com/ElBenjaMasLindo/folex#readme",
  "bugs": {
    "url": "https://github.com/ElBenjaMasLindo/folex/issues"
  },
  "license": "MIT"
}
